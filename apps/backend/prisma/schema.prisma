generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model Employee {
  id             String           @id @default(uuid())
  employeeId     String           @unique
  fullName       String
  email          String           @unique
  jobTitle       String
  department     String
  country        String
  salary         Float
  currency       String
  employmentType EmploymentType
  dateOfJoining  DateTime
  managerName    String?
  status         EmployeeStatus
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([country])
  @@index([jobTitle])
  @@index([country, jobTitle])
}